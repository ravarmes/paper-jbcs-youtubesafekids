# Copie para .env e preencha. O .env NAO vai para o repositorio (ver .gitignore).
#
# Necessario apenas para o servico web e para o estudo de caso sobre buscas
# reais. A reproducao dos resultados do modelo (passos 1 a 8 do README) nao
# precisa de chave.
YOUTUBE_API_KEY=

# Endereco do Ollama, usado apenas pela baseline generativa
# (app/nlp/training/train_toxicity_llm_baselines.py).
OLLAMA_HOST=http://localhost:11434

# Modelos generativos a avaliar, separados por virgula. Vazio usa o padrao do
# script (llama3.1:8b), que e o reportado no artigo.
TOX_LLM_MODELS=
