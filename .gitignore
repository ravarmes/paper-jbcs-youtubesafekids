# Ambientes virtuais criados dentro de data/ -- o padrao "venv/" acima nao os
# pega, e eles chegaram a ser versionados por engano no repositorio de origem.
data/.venv*/
**/.venv*/

# Segredos: so o exemplo vai para o repositorio
.env
.env.*
!.env.example

# O corpus publicado (data/corpus_toxicidade_publico.csv) traz as frases e vai ao ar.
# O que fica de fora sao as copias de trabalho: o corpus mestre e os intermediarios,
# que duplicariam o mesmo conteudo com outro nome e outra ordem de colunas.
data/corpus_toxicidade.csv
data/corpus_toxicidade_completo.csv
data/*_completo.csv
!data/corpus_toxicidade_publico.csv

# Mesma regra para o corpus mestre, que tambem tem a coluna FRASE e e o
# PATHS['corpus_file'] de app/nlp/config.py. Fica fora do caminho data/, entao
# os padroes acima nao o pegam.
app/nlp/datasets/corpus.csv
app/nlp/datasets/corpus_backup.csv